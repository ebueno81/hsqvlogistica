@page "/garantias"
@inherits SecurePageBase

@using HsqvLogistica.Models.DTOs.Garantias
@using HsqvLogistica.Services.Interfaces
@using HsqvLogistica.States
@using MudBlazor

@inject IGarantiaService GarantiaService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IUserSessionService UserSession
@inject FiltroStateService FiltroService

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6">

    <!-- ================= HEADER ================= -->
    <MudStack Direction="Row"
              Justify="Justify.SpaceBetween"
              AlignItems="AlignItems.Center"
              Class="mb-4">

        <MudText Typo="Typo.h5">📦 Garantías</MudText>

        @if (UserSession.UsuarioActual?.Permisos.PuedeCrearGarantia == true)
        {
            <MudButton Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@(() => Navigation.NavigateTo("/garantias/nuevo"))">
                Nueva Garantía
            </MudButton>
        }
    </MudStack>

    <!-- ================= FILTROS ================= -->
    <MudPaper Class="pa-4 mb-4">

        <MudGrid Spacing="2" AlignItems="AlignItems.End">

            <MudItem xs="12" md="2">
                <MudSelect T="bool?"
                           Label="Estado"
                           Dense="true"
                           Variant="Variant.Text"
                           @bind-Value="_filtro.Estado">

                    <MudSelectItem T="bool?" Value="@(null)">
                        Todos
                    </MudSelectItem>

                    <MudSelectItem T="bool?" Value="false">
                        Pendiente
                    </MudSelectItem>

                    <MudSelectItem T="bool?" Value="true">
                        Cerrado
                    </MudSelectItem>

                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="3">
                <MudTextField Label="Cliente"
                              @bind-Value="_filtro.Cliente"
                              Dense
                              Variant="Variant.Text"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.PersonSearch" />
            </MudItem>

            <MudItem xs="12" md="2">
                <MudDatePicker Label="Desde"
                               @bind-Date="_filtro.FechaDesde"
                               Dense />
            </MudItem>

            <MudItem xs="12" md="2">
                <MudDatePicker Label="Hasta"
                               @bind-Date="_filtro.FechaHasta"
                               Dense />
            </MudItem>

            <MudItem xs="12" md="2" Class="d-flex align-end">
                <MudButton Color="Color.Primary"
                           OnClick="Buscar">
                    Buscar
                </MudButton>
            </MudItem>

        </MudGrid>

    </MudPaper>

    <!-- ================= TABLA ================= -->
    <MudTable T="GarantiaDto"
              @ref="_table"
              ServerData="LoadServerData"
              CurrentPage="@_filtro.Pagina"
              CurrentPageChanged="OnPaginaChanged"
              RowsPerPage="10"
              Dense
              Hover
              Striped>

        <HeaderContent>
            <MudTh>#</MudTh>
            <MudTh>Cliente</MudTh>
            <MudTh>Guia</MudTh>
            <MudTh>Transporte</MudTh>
            <MudTh>Despacho</MudTh>
            <MudTh>Entrega</MudTh>
            <MudTh>Estado</MudTh>
            <MudTh>Vigencia</MudTh>
            <MudTh Align="Align.Right">Acciones</MudTh>
        </HeaderContent>

        <RowTemplate Context="row">

            <MudTd>@row.Id</MudTd>
            <MudTd>@row.Cliente</MudTd>
            <MudTd>@row.NroSerie - @row.NroGuia</MudTd>
            <MudTd>@row.EmpresaServicio</MudTd>
            <MudTd>@row.FechaDespacho?.ToString("dd/MM/yyyy")</MudTd>
            <MudTd>@row.FechaEntrega?.ToString("dd/MM/yyyy")</MudTd>

            <!-- ESTADO -->
            <MudTd>
                <MudChip T="string"
                         Color="@(row.Estado ? Color.Success : Color.Warning)"
                         Size="Size.Small">
                    @(row.Estado ? "Cerrado" : "Pendiente")
                </MudChip>
            </MudTd>

            <!-- VIGENCIA -->
            <MudTd>
                @if (row.Activo)
                {
                    <MudTooltip Text="Anular garantía">
                        <MudChip T="string"
                                 Color="Color.Success"
                                 Variant="Variant.Filled"
                                 Size="Size.Small"
                                 Clickable="@PuedeAnular"
                                 Style="@($"cursor:{(PuedeAnular ? "pointer" : "default")};")"
                                 OnClick="@(PuedeAnular
                                                                      ? (() => ConfirmarAnular(row.Id))
                                                                      : null)">
                        Activo
                    </MudChip>
                </MudTooltip>
                                }
                else
                {
                    <MudChip T="string"
                             Color="Color.Error"
                             Variant="Variant.Filled"
                             Size="Size.Small">
                        Anulado
                    </MudChip>
                }
            </MudTd>

            <!-- ACCIONES -->
            <MudTd Align="Align.Right">

                <MudTooltip Text="Ver">
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   OnClick="@(() => Ver(row.Id))" />
                </MudTooltip>

                @if (!row.Estado && row.Activo)
                {
                    @if (UserSession.UsuarioActual?.Permisos.PuedeAnularOperaciones == true)
                    {
                        <MudTooltip Text="Editar">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Info"
                                           Size="Size.Small"
                                           OnClick="@(() => Editar(row.Id))" />
                        </MudTooltip>

                        <MudTooltip Text="Cerrar">
                            <MudIconButton Icon="@Icons.Material.Filled.DoneAll"
                                           Color="Color.Success"
                                           Size="Size.Small"
                                           OnClick="@(() => ConfirmarCierre(row.Id))" />
                        </MudTooltip>
                    }
                }

            </MudTd>

        </RowTemplate>

        <NoRecordsContent>
            <MudText Color="Color.Secondary">
                No se encontraron garantías.
            </MudText>
        </NoRecordsContent>

        <PagerContent>
            <MudTablePager PageSizeOptions="@(new int[] { 10, 20, 50, 100 })"
                           RowsPerPageString="Registros por página"
                           InfoFormat="{first_item}-{last_item} de {all_items}"
                           HorizontalAlignment="HorizontalAlignment.Right" />
        </PagerContent>

    </MudTable>

</MudContainer>

@code {

    // ==========================================
    // ESTADO DE FILTROS
    // ==========================================

    private GarantiaFiltroState _filtro = new();

    private MudTable<GarantiaDto>? _table;

    private bool PuedeAnular =>
        UserSession.UsuarioActual?.Permisos.PuedeAnularOperaciones == true;

    // ==========================================
    // INICIALIZACIÓN
    // ==========================================

    protected override async Task OnInitializedAsync()
    {
        // Recuperar filtros antes del primer renderizado
        _filtro = FiltroService.Obtener<GarantiaFiltroState>();

        await base.OnInitializedAsync();

        if (!IsAuthorized)
            return;
    }

    // ==========================================
    // CAMBIO DE PÁGINA
    // ==========================================

    private void OnPaginaChanged(int pagina)
    {
        _filtro.Pagina = Math.Max(0, pagina);
    }

    // ==========================================
    // LISTADO DE GARANTÍAS
    // ==========================================

    private async Task<TableData<GarantiaDto>> LoadServerData(
        TableState state,
        CancellationToken cancellationToken)
    {
        try
        {
            int pagina = Math.Max(0, state.Page);

            _filtro.Pagina = pagina;

            var filtro = new GarantiaFilterDto
            {
                Cliente = _filtro.Cliente,
                Estado = _filtro.Estado,

                FechaDesde = _filtro.FechaDesde.HasValue
                    ? DateOnly.FromDateTime(_filtro.FechaDesde.Value)
                    : null,

                FechaHasta = _filtro.FechaHasta.HasValue
                    ? DateOnly.FromDateTime(_filtro.FechaHasta.Value)
                    : null,

                Page = pagina,
                PageSize = state.PageSize
            };

            // Se conserva la firma actual del servicio.
            var result = await GarantiaService.SearchAsync(filtro);

            return new TableData<GarantiaDto>
            {
                Items = result.Items,
                TotalItems = result.TotalItems
            };
        }
        catch (OperationCanceledException)
            when (cancellationToken.IsCancellationRequested)
        {
            return new TableData<GarantiaDto>
            {
                Items = new List<GarantiaDto>(),
                TotalItems = 0
            };
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"ERROR AL CARGAR GARANTÍAS: {ex}");

            Snackbar.Add(
                "Ocurrió un error al consultar las garantías.",
                Severity.Error);

            return new TableData<GarantiaDto>
            {
                Items = new List<GarantiaDto>(),
                TotalItems = 0
            };
        }
    }

    // ==========================================
    // NAVEGACIÓN
    // ==========================================

    private void Ver(int id)
    {
        Navigation.NavigateTo($"/garantias/ver/{id}");
    }

    private void Editar(int id)
    {
        Navigation.NavigateTo($"/garantias/editar/{id}");
    }

    // ==========================================
    // BUSCAR
    // ==========================================

    private async Task Buscar()
    {
        if (_table is null)
            return;

        _filtro.Pagina = 0;

        if (_table.CurrentPage != 0)
        {
            _table.NavigateTo(0);
        }
        else
        {
            await _table.ReloadServerData();
        }
    }

    // ==========================================
    // CERRAR GARANTÍA
    // ==========================================

    private async Task ConfirmarCierre(int id)
    {
        bool? ok = await DialogService.ShowMessageBox(
            "Cerrar Garantía",
            "¿Está seguro de cerrar esta garantía? No podrá modificarse luego.",
            yesText: "Sí, cerrar",
            cancelText: "Cancelar");

        if (ok == true)
        {
            await GarantiaService.CloseAsync(
                id,
                UserSession.UsuarioActual!.Usuario);

            Snackbar.Add(
                "Garantía cerrada correctamente",
                Severity.Success);

            if (_table is not null)
                await _table.ReloadServerData();
        }
    }

    // ==========================================
    // ANULAR GARANTÍA
    // ==========================================

    private async Task ConfirmarAnular(int id)
    {
        bool? ok = await DialogService.ShowMessageBox(
            "Anular Garantía",
            "¿Está seguro de anular esta garantía? Esta acción no se puede deshacer.",
            yesText: "Sí, anular",
            cancelText: "Cancelar");

        if (ok == true)
        {
            await GarantiaService.AnularAsync(
                id,
                UserSession.UsuarioActual!.Usuario);

            Snackbar.Add(
                "Garantía anulada correctamente",
                Severity.Warning);

            if (_table is not null)
                await _table.ReloadServerData();
        }
    }
}
