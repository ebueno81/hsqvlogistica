@page "/pedidos"
@inherits SecurePageBase

@using HsqvLogistica.Components.Pages.Dialogs
@using HsqvLogistica.Models.DTOs.Pedidos
@using HsqvLogistica.Services.Interfaces
@using HsqvLogistica.States
@using MudBlazor

@inject IPedidoService PedidoService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IUserSessionService UserSession
@inject FiltroStateService FiltroService

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6">

    <!-- ================= CABECERA ================= -->
    <MudStack Direction="Row"
              Justify="Justify.SpaceBetween"
              AlignItems="AlignItems.Center"
              Class="mb-4">

        <MudText Typo="Typo.h5">Pedidos</MudText>
        @if (UserSession.UsuarioActual?.Permisos.PuedeCrearPedidos == true)
        {
            <MudButton Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="GoNuevoPedido"
                       Disabled="@_isNavigating">
                Nuevo Pedido
            </MudButton>
        }
    </MudStack>

    <!-- ================= FILTROS ================= -->
    <MudPaper Elevation="1" Class="pa-4 mb-4">

        <MudGrid Spacing="3">

            <MudItem xs="12" md="4">
                <MudTextField Label="Cliente"
                              @bind-Value="_filtro.Cliente"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" />
            </MudItem>

            <MudItem xs="12" md="2">
                <MudDatePicker Label="Desde"
                               @bind-Date="_filtro.FechaDesde"
                               Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="12" md="2">
                <MudDatePicker Label="Hasta"
                               @bind-Date="_filtro.FechaHasta"
                               Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="12" sm="6" md="2">
                <MudSelect T="int?"
                           Label="Estado del Pedido"
                           @bind-Value="_filtro.Estado"
                           Variant="Variant.Outlined"
                           
                           FullWidth="true">

                    <MudSelectItem T="int?" Value="@((int?)null)">
                        Todos
                    </MudSelectItem>

                    @foreach (var estado in _estadosPedido)
                    {
                        <MudSelectItem T="int?" Value="@((int?)estado)">
                            @GetEstadoTexto(estado)
                        </MudSelectItem>
                    }

                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="2" Class="d-flex align-end">
                <MudButton Color="Color.Primary"
                           Variant="Variant.Filled"
                           OnClick="Buscar">
                    Buscar
                </MudButton>
            </MudItem>

        </MudGrid>

    </MudPaper>

    <!-- ================= TABLA ================= -->
    <MudPaper Elevation="2" Class="pa-4">

        <MudTable T="PedidoDto"
                  @ref="_table"
                  ServerData="LoadServerData"
                  CurrentPage="@_filtro.Pagina"
                  CurrentPageChanged="OnPaginaChanged"
                  Dense
                  Hover
                  Striped
                  RowsPerPage="10">

            <HeaderContent>
                <MudTh Style="font-weight:bold;">Id</MudTh>
                <MudTh Style="font-weight:bold;">Cliente</MudTh>
                <MudTh Style="font-weight:bold;">Fecha</MudTh>
                <MudTh Style="font-weight:bold;">Usuario</MudTh>
                <MudTh Style="font-weight:bold;">Estado</MudTh>
                @if (UserSession.UsuarioActual?.Permisos.PuedeAnularOperaciones == true)
                {
                    <MudTh Style="font-weight:bold;">Anulado</MudTh>
                }
                <MudTh Align="Right"></MudTh>
            </HeaderContent>

            <RowTemplate Context="row">

                <MudTd>@row.Id</MudTd>
                <MudTd>@row.Cliente</MudTd>
                <MudTd>@row.FechaEntrega?.ToString("dd/MM/yyyy")</MudTd>
                <MudTd>@row.UsuaCreacion</MudTd>

                <MudTd DataLabel="Estado">
                    <MudChip T="string"
                             Color="@GetEstadoColor(row.Estado)"
                             Variant="Variant.Filled"
                             Size="Size.Small">
                        @GetEstadoTexto(row.Estado)
                    </MudChip>
                </MudTd>
                @if (UserSession.UsuarioActual?.Permisos.PuedeAnularOperaciones == true)
                {
                    <MudTd>
                        <MudChip T="string"
                                 Color="@(row.Activo == true ? Color.Success : Color.Error)"
                                 Variant="Variant.Filled"
                                 Size="Size.Small"
                                 Clickable="@(PuedeAnular(row) && !_idPedidoProcesando.HasValue)"
                                 Style="@(PuedeAnular(row) ? "cursor:pointer;" : "cursor:default;")"
                                 OnClick="@(PuedeAnular(row) && !_idPedidoProcesando.HasValue
                                     ? (() => ConfirmarAnulacion(row))
                                     : null)">
                            @(row.Activo == true ? "Activo" : "Anulado")
                        </MudChip>
                    </MudTd>
                }


                <MudTd Align="Align.Right">

                    @* MOSTRAR PEDIDO *@
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                   Color="Color.Primary"
                                   Title="Mostrar pedido"
                                   Disabled="@(_idPedidoProcesando.HasValue)"
                                   OnClick="@(() => Navigation.NavigateTo($"/pedidos/ver/{row.Id}"))" />

                    @if (UserSession.UsuarioActual?.Permisos.PuedeAprobarPedidos == true)
                    {
                        @* APROBAR: solo pedidos pendientes y activos *@
                        @if (row.Estado == 0 && row.Activo == true)
                        {
                            <MudIconButton Icon="@(_idPedidoProcesando == row.Id
                                                                           ? Icons.Material.Filled.HourglassEmpty
                                                                           : Icons.Material.Filled.CheckCircle)"
                                   Color="Color.Success"
                                   Title="@(_idPedidoProcesando == row.Id
                                                                   ? "Procesando aprobación..."
                                                                   : "Aprobar pedido")"
                                   Disabled="@(_idPedidoProcesando.HasValue)"
                                   OnClick="@(() => ConfirmarAprobacion(row))" />
                                        }
                    }

                </MudTd>

            </RowTemplate>

            <NoRecordsContent>
                <MudText Color="Color.Secondary">
                    No se encontraron pedidos
                </MudText>
            </NoRecordsContent>

            <!-- PAGINACIÓN -->
            <PagerContent>
                <MudTablePager PageSizeOptions="@(new int[] { 10, 20, 50, 100 })"
                               RowsPerPageString="Registros por página"
                               InfoFormat="{first_item}-{last_item} de {all_items}"
                               HorizontalAlignment="HorizontalAlignment.Right" />
            </PagerContent>

        </MudTable>

    </MudPaper>

</MudContainer>


@code {

    string? _cliente;
    DateTime? _fechaDesde = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    DateTime? _fechaHasta = DateTime.Today;

    MudTable<PedidoDto>? _table;

    private bool _isNavigating = false;

    private readonly int[] _estadosPedido = { 0, 1, 2, 3 };

    private int? _idPedidoProcesando = null;

    private void GoNuevoPedido()
    {
        if (_isNavigating)
            return;

        _isNavigating = true;

        Navigation.NavigateTo("/pedidos/nuevo");
    }

    private PedidoFiltroState _filtro = new();

    private void OnPaginaChanged(int pagina)
    {
        _filtro.Pagina = Math.Max(0, pagina);
    }

    protected override async Task OnInitializedAsync()
    {
        // Recuperar filtros guardados antes del primer renderizado
        _filtro = FiltroService.Obtener<PedidoFiltroState>();

        await base.OnInitializedAsync();

        if (!IsAuthorized)
            return;

    }

    private async Task<TableData<PedidoDto>> LoadServerData(
    TableState state,
    CancellationToken cancellationToken)
    {
        try
        {
            int pagina = Math.Max(0, state.Page);

            _filtro.Pagina = pagina;

            var filtro = new PedidoFilterDto
            {
                Cliente = _filtro.Cliente,

                FechaDesde = _filtro.FechaDesde.HasValue
                    ? DateOnly.FromDateTime(_filtro.FechaDesde.Value)
                    : null,

                FechaHasta = _filtro.FechaHasta.HasValue
                    ? DateOnly.FromDateTime(_filtro.FechaHasta.Value)
                    : null,

                Estado = _filtro.Estado,

                Page = state.Page,
                PageSize = state.PageSize
            };

            var result = await PedidoService.SearchAsync(
                filtro,
                cancellationToken);

            return new TableData<PedidoDto>
            {
                Items = result.Items,
                TotalItems = result.TotalItems
            };
        }
        catch (OperationCanceledException)
            when (cancellationToken.IsCancellationRequested)
        {
            return new TableData<PedidoDto>
            {
                Items = new List<PedidoDto>(),
                TotalItems = 0
            };
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ERROR AL CARGAR PEDIDOS: {ex}");

            Snackbar.Add(
                "Ocurrió un error al consultar los pedidos.",
                Severity.Error);

            return new TableData<PedidoDto>
            {
                Items = new List<PedidoDto>(),
                TotalItems = 0
            };
        }
    }

    private async Task Buscar()
    {
        if (_table is null)
            return;

        _filtro.Pagina = 0;

        if (_table.CurrentPage != 0)
        {
            _table.NavigateTo(0);
        }
        else
        {
            await _table.ReloadServerData();
        }
    }


    private async Task ConfirmarAprobacion(PedidoDto pedido)
    {
        // Evitar múltiples ejecuciones simultáneas
        if (_idPedidoProcesando.HasValue)
            return;

        // Verificar permisos y estado actual de la fila
        if (UserSession.UsuarioActual?.Permisos.PuedeAprobarPedidos != true ||
            pedido.Estado != 0 ||
            pedido.Activo != true)
            return;

        // Bloquear inmediatamente
        _idPedidoProcesando = pedido.Id;

        try
        {
            // Mostrar los botones deshabilitados
            await InvokeAsync(StateHasChanged);

            var options = new DialogOptions
            {
                CloseButton = true,
                MaxWidth = MaxWidth.Small,
                FullWidth = true
            };

            bool? result = await DialogService.ShowMessageBox(
                title: "Confirmar aprobación",
                message: $"¿Desea aprobar el pedido #{pedido.Id}?",
                yesText: "Aprobar",
                cancelText: "Cancelar",
                options: options);

            // El usuario canceló o cerró el diálogo
            if (result != true)
                return;

            var usuario = UserSession.UsuarioActual?.Usuario;

            if (string.IsNullOrWhiteSpace(usuario))
            {
                Snackbar.Add(
                    "La sesión no está disponible.",
                    Severity.Warning);
                return;
            }

            // Actualizar estado en SQL Server
            bool actualizado = await actualizarEstadoPedido(
                pedido.Id,
                1,
                usuario);

            // Validar el resultado del servicio
            if (!actualizado)
            {
                Snackbar.Add(
                    "No se pudo aprobar el pedido. Verifique su estado.",
                    Severity.Warning);
                return;
            }

            // Refrescar la tabla antes de desbloquear
            if (_table is not null)
                await _table.ReloadServerData();

            Snackbar.Add(
                $"Pedido #{pedido.Id} aprobado correctamente.",
                Severity.Success);
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"ERROR AL APROBAR PEDIDO #{pedido.Id}: {ex}");

            Snackbar.Add(
                "Ocurrió un error al aprobar el pedido.",
                Severity.Error);
        }
        finally
        {
            // Desbloquear si cancela, falla o termina correctamente
            _idPedidoProcesando = null;
        }
    }


    bool PuedeAnular(PedidoDto row)
    {
        return row.Activo == true &&
               (row.Estado == 0 || row.Estado == 1);
    }

    async Task<bool> actualizarEstadoPedido(int idPedido, int estadoPedido, string usuarioModifica)
    {
        return await PedidoService.ChangeStatusAsync(idPedido, estadoPedido, usuarioModifica);
    }

    async Task ConfirmarAnulacion(PedidoDto pedido)
    {
        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        bool? result = await DialogService.ShowMessageBox(
            title: "Confirmar anulación",
            message: $"¿Está seguro que desea anular el pedido #{pedido.Id}?",
            yesText: "Anular",
            cancelText: "Cancelar",
            options: options);

        if (result == true)
        {
            await PedidoService.AnularPedido(pedido.Id, UserSession.UsuarioActual.Usuario);
            Snackbar.Add(
                $"Pedido #{pedido.Id} anulado correctamente",
                Severity.Success,
                options =>
                {
                    options.CloseAfterNavigation = true;
                });

            // 🔄 Refrescar tabla
            if (_table is not null)
                await _table.ReloadServerData();
        }
    }

    string GetEstadoTexto(int? estado)
    {
        return estado switch
        {
            0 => "Pendiente",
            1 => "Aprobado",
            2 => "Despacho",
            3 => "Cerrado",
            _ => "Desconocido"
        };
    }

    Color GetEstadoColor(int? estado)
    {
        return estado switch
        {
            0 => Color.Error,      // Rojo
            1 => Color.Warning,    // Amarillo
            2 => Color.Info,       // Azul
            3 => Color.Success,    // Verde
            _ => Color.Default
        };
    }
}
