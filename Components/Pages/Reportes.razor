@page "/reportes"
@inherits SecurePageBase

@using HsqvLogistica.Models.DTOs.Almacen
@using HsqvLogistica.Models.DTOs.Articulos
@using HsqvLogistica.Models.DTOs.Lineas
@using HsqvLogistica.Models.DTOs.Reportes
@using HsqvLogistica.Services.Interfaces
@using MudBlazor

@inject IArticuloService ArticuloService
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.False" Class="mt-6 px-6">

    <!-- HEADER -->
    <MudText Typo="Typo.h5" Class="fw-bold mb-1">
        Reportes del Sistema
    </MudText>
    <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-5">
        Generación de reportes y análisis
    </MudText>

    <MudGrid Spacing="4">

        <!-- =========================
             Movimientos (Kardex)
             ========================= -->
        <MudItem xs="12" md="4">
            <MudCard Class="report-card">

                <MudCardHeader Style="background-color:#f3f6fd;">


                    <CardHeaderAvatar>
                        <MudAvatar Color="Color.Info" Size="Size.Small">
                            <MudIcon Icon="@Icons.Material.Filled.SyncAlt" />
                        </MudAvatar>
                    </CardHeaderAvatar>

                    <CardHeaderContent>
                        <MudText Typo="Typo.subtitle1" Class="fw-bold">
                            Movimientos (Kardex)
                        </MudText>
                    </CardHeaderContent>

                </MudCardHeader>

                <MudCardContent>
                    <MudStack Spacing="1">

                        <MudDatePicker Label="Fecha Desde"
                                       @bind-Date="_fechaDesdeKardex"
                                       Margin="Margin.Dense"
                                       Dense="true" />

                        <MudDatePicker Label="Fecha Desde"
                                       @bind-Date="_fechaHastaKardex"
                                       Margin="Margin.Dense"
                                       Dense="true" />

                        <MudSelect T="TipoMovimiento"
                                   Label="Tipo"
                                   Dense
                                   Margin="Margin.Dense"
                                   @bind-Value="_tipo">

                            <MudSelectItem Value="TipoMovimiento.Todos">Todos</MudSelectItem>
                            <MudSelectItem Value="TipoMovimiento.Ingreso">Ingreso</MudSelectItem>
                            <MudSelectItem Value="TipoMovimiento.Salida">Salida</MudSelectItem>

                        </MudSelect>

                        <MudAutocomplete T="ArticuloLookupDto"
                                         Label="Artículo"
                                         Placeholder="Todos los artículos"
                                         @bind-Value="_articuloSeleccionado"
                                         SearchFunc="BuscarArticulos"
                                         ToStringFunc="@(a => a?.Descripcion ?? string.Empty)"
                                         Clearable="true"
                                         ResetValueOnEmptyText="true"
                                         CoerceText="false"
                                         Dense="true"
                                         Margin="Margin.Dense"
                                         MaxItems="20" />
                    </MudStack>
                </MudCardContent>

                <MudCardActions>
                    <MudButton Color="Color.Success"
                               Variant="Variant.Filled"
                               StartIcon="@(_exportandoKardex
                                              ? Icons.Material.Filled.HourglassEmpty
                                              : Icons.Material.Filled.FileDownload)"
                               OnClick="ExportarKardexExcel"
                               Disabled="@_exportandoKardex"
                               FullWidth>

                        @if (_exportandoKardex)
                        {
                            <MudProgressCircular Size="Size.Small"
                                                 Indeterminate="true"
                                                 Color="Color.Inherit"
                                                 Class="me-2" />

                            <MudText>Generando Excel...</MudText>
                        }
                        else
                        {
                            <MudText>Exportar Excel</MudText>
                        }

                    </MudButton>
                </MudCardActions>

            </MudCard>
        </MudItem>

        <!-- =========================
             REPORTE DE PEDIDOS
             ========================= -->
        <MudItem xs="12" md="4">
            <MudCard Class="report-card">

                <MudCardHeader Style="background-color:#f3f6fd;">

                    <CardHeaderAvatar>
                        <MudAvatar Color="Color.Primary" Size="Size.Small">
                            <MudIcon Icon="@Icons.Material.Filled.Assignment" />
                        </MudAvatar>
                    </CardHeaderAvatar>

                    <CardHeaderContent>
                        <MudText Typo="Typo.subtitle1" Class="fw-bold">
                            Reporte de Pedidos
                        </MudText>
                    </CardHeaderContent>

                </MudCardHeader>

                <MudCardContent>
                    <MudStack Spacing="1">

                        <!-- FECHA DESDE -->
                        <MudDatePicker Label="Fecha Desde"
                                       @bind-Date="_fechaDesdePedido"
                                       Margin="Margin.Dense"
                                       Dense="true" />

                        <!-- FECHA HASTA -->
                        <MudDatePicker Label="Fecha Hasta"
                                       @bind-Date="_fechaHastaPedido"
                                       Margin="Margin.Dense"
                                       Dense="true" />

                        <!-- ESTADO -->
                        <MudSelect T="int?"
                                   Label="Estado del Pedido"
                                   @bind-Value="_estadoPedido"
                                   Dense="true"
                                   Margin="Margin.Dense">

                            <MudSelectItem T="int?" Value="@((int?)null)">
                                Todos
                            </MudSelectItem>

                            <MudSelectItem T="int?" Value="@((int?)0)">
                                Pendiente
                            </MudSelectItem>

                            <MudSelectItem T="int?" Value="@((int?)1)">
                                Aprobado
                            </MudSelectItem>

                            <MudSelectItem T="int?" Value="@((int?)2)">
                                Despacho
                            </MudSelectItem>

                            <MudSelectItem T="int?" Value="@((int?)3)">
                                Cerrado
                            </MudSelectItem>

                        </MudSelect>

                        <!-- CLIENTE -->
                        <MudTextField T="string"
                                      Label="Cliente"
                                      Placeholder="Todos los clientes"
                                      @bind-Value="_clientePedido"
                                      Clearable="true"
                                      Dense="true"
                                      Margin="Margin.Dense"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search" />

                    </MudStack>
                </MudCardContent>

                <MudCardActions>
                    <MudButton Color="Color.Success"
                               Variant="Variant.Filled"
                               StartIcon="@(_exportandoPedido
                                                                                         ? Icons.Material.Filled.HourglassEmpty
                                                                                         : Icons.Material.Filled.FileDownload)"
                               OnClick="ExportarPedidoExcel"
                               Disabled="@_exportandoPedido"
                               FullWidth>

                        @if (_exportandoPedido)
                        {
                            <MudProgressCircular Size="Size.Small"
                                                 Indeterminate="true"
                                                 Color="Color.Inherit"
                                                 Class="me-2" />

                            <MudText>Generando Excel...</MudText>
                        }
                        else
                        {
                            <MudText>Exportar Excel</MudText>
                        }

                    </MudButton>
                </MudCardActions>

            </MudCard>
        </MudItem>
        
        <!-- =========================
             Reporte Garantías
             ========================= -->
        <MudItem xs="12" md="4">
            <MudCard Class="report-card">

                <MudCardHeader Style="background-color:#f3f6fd;">
                    <CardHeaderAvatar>
                        <MudAvatar Color="Color.Secondary" Size="Size.Small">
                            <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" />
                        </MudAvatar>
                    </CardHeaderAvatar>
                    <CardHeaderContent>
                        <MudText Typo="Typo.subtitle1" Class="fw-bold">
                            Reporte Garantías
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>

                <MudCardContent>
                    <MudStack Spacing="1">

                        <MudDatePicker Label="Fecha Desde"
                                       @bind-Date="_fechaDesdeGarantia"
                                       Margin="Margin.Dense"
                                       Dense="true" />
                        <MudDatePicker Label="Fecha Desde"
                                       @bind-Date="_fechaHastaGarantia"
                                       Margin="Margin.Dense"
                                       Dense="true" />

                        <MudSelect T="TipoEstadoGarantia"
                                   Label="Estado"
                                   Dense
                                   Margin="Margin.Dense"
                                   @bind-Value="_tipoEstado">

                            <MudSelectItem Value="TipoEstadoGarantia.Todos">Todos</MudSelectItem>
                            <MudSelectItem Value="TipoEstadoGarantia.Pendientes">Pendientes</MudSelectItem>
                            <MudSelectItem Value="TipoEstadoGarantia.Cerrados">Cerrados</MudSelectItem>

                        </MudSelect>

                    </MudStack>
                </MudCardContent>

                <MudCardActions>
                    <MudButton Color="Color.Success"
                               Variant="Variant.Filled"
                               StartIcon="@(_exportandoGarantia
                                                  ? Icons.Material.Filled.HourglassEmpty
                                                  : Icons.Material.Filled.FileDownload)"
                               OnClick="ExportarGarantiaExcel"
                               Disabled="@_exportandoGarantia"
                               FullWidth>

                        @if (_exportandoGarantia)
                        {
                            <MudProgressCircular Size="Size.Small"
                                                 Indeterminate="true"
                                                 Color="Color.Inherit"
                                                 Class="me-2" />

                            <MudText>Generando Excel...</MudText>
                        }
                        else
                        {
                            <MudText>Exportar Excel</MudText>
                        }

                    </MudButton>
                </MudCardActions>

            </MudCard>
        </MudItem>

        <!-- =========================
             Reporte de Stock
             ========================= -->
        <MudItem xs="12" md="4">
            <MudCard Class="report-card">

                <MudCardHeader Style="background-color:#f3f6fd;">
                    <CardHeaderAvatar>
                        <MudAvatar Color="Color.Success" Size="Size.Small">
                            <MudIcon Icon="@Icons.Material.Filled.Inventory" />
                        </MudAvatar>
                    </CardHeaderAvatar>
                    <CardHeaderContent>
                        <MudText Typo="Typo.subtitle1" Class="fw-bold">
                            Reporte de Stock
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>

                <MudCardContent>
                    <MudStack Spacing="1">

                        <MudSelect T="int?"
                                   Label="Almacén"
                                   Dense
                                   Margin="Margin.Dense"
                                   @bind-Value="_idAlmacen">

                            <MudSelectItem Value="@((int?)null)">
                                Todos los almacenes
                            </MudSelectItem>

                            @foreach (var almacen in _almacenes)
                            {
                                <MudSelectItem Value="@((int?)almacen.Id)">
                                    @almacen.Nombre
                                </MudSelectItem>
                            }

                        </MudSelect>

                        <MudSelect T="int?"
                                   Label="Línea"
                                   Dense
                                   Margin="Margin.Dense"
                                   @bind-Value="_idLinea">

                            <MudSelectItem Value="@((int?)null)">
                                Todas las líneas
                            </MudSelectItem>

                            @foreach (var linea in _lineas)
                            {
                                <MudSelectItem Value="@((int?)linea.Id)">
                                    @linea.Descripcion
                                </MudSelectItem>
                            }

                        </MudSelect>

                    </MudStack>
                </MudCardContent>

                <MudCardActions>
                    <MudButton Color="Color.Success"
                               Variant="Variant.Filled"
                               StartIcon="@(_exportandoStock
                                                                                 ? Icons.Material.Filled.HourglassEmpty
                                                                                 : Icons.Material.Filled.FileDownload)"
                               OnClick="ExportarStockExcel"
                               Disabled="@_exportandoStock"
                               FullWidth>

                        @if (_exportandoStock)
                        {
                            <MudProgressCircular Size="Size.Small"
                                                 Indeterminate="true"
                                                 Color="Color.Inherit"
                                                 Class="me-2" />

                            <MudText>Generando Excel...</MudText>
                        }
                        else
                        {
                            <MudText>Exportar Excel</MudText>
                        }

                    </MudButton>
                </MudCardActions>

            </MudCard>
        </MudItem>

    </MudGrid>

</MudContainer>

@code {

    [Inject] private IAlmacenService AlmacenService { get; set; } = default!;
    [Inject] private ILineaService LineaService { get; set; } = default!;
    [Inject] private IReporteService ReporteService { get; set; } = default!;
    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;

    private TipoMovimiento _tipo = TipoMovimiento.Todos;
    private TipoEstadoGarantia _tipoEstado = TipoEstadoGarantia.Todos;

    private ArticuloLookupDto? _articuloSeleccionado;

    private int? _idAlmacen;
    private int? _idLinea;

    private List<AlmacenDto> _almacenes = new();
    private List<LineaDto> _lineas = new();

    private DateTime? _fechaDesdeKardex =
        new(DateTime.Today.Year, DateTime.Today.Month, 1);

    private DateTime? _fechaHastaKardex =
        DateTime.Today;

    private DateTime? _fechaDesdeGarantia =
        new(DateTime.Today.Year, DateTime.Today.Month, 1);

    private DateTime? _fechaHastaGarantia =
        DateTime.Today;

    private bool _exportandoKardex = false;

    private bool _exportandoStock = false;

    private bool _exportandoGarantia = false;


    // =============================
    // FILTROS REPORTE DE PEDIDOS
    // =============================

    private DateTime? _fechaDesdePedido =
        new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);

    private DateTime? _fechaHastaPedido = DateTime.Today;

    // Null = todos los estados
    private int? _estadoPedido = null;

    // Vacío = todos los clientes
    private string? _clientePedido = string.Empty;

    // Evita exportaciones duplicadas
    private bool _exportandoPedido = false;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        if (!IsAuthorized)
            return;

        await CargarCombosAsync();
    }

    private async Task CargarCombosAsync()
    {
        _almacenes = (await AlmacenService.GetAllAsync())
            .OrderBy(x => x.Nombre)
            .ToList();

        _lineas = (await LineaService.GetAllAsync())
            .OrderBy(x => x.Descripcion)
            .ToList();
    }

    private async Task ExportarStockExcel()
    {
        if (_exportandoStock)
            return;

        _exportandoStock = true;

        try
        {
            var filtro = new ReporteStockFilterDto
            {
                IdAlmacen = _idAlmacen,
                IdLinea = _idLinea
            };

            var archivo = await ReporteService.ExportarStockExcelAsync(filtro);

            // Verificar si se generó un archivo
            if (archivo == null || archivo.Length == 0)
            {
                Snackbar.Add(
                    "No existen registros para exportar.",
                    Severity.Info);

                return;
            }

            await JSRuntime.InvokeVoidAsync(
                "downloadFile",
                "ReporteStock.xlsx",
                Convert.ToBase64String(archivo));

            Snackbar.Add(
                "Reporte de Stock exportado correctamente.",
                Severity.Success);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ERROR EXPORTANDO STOCK: {ex}");

            Snackbar.Add(
                "Ocurrió un error al exportar el reporte de Stock.",
                Severity.Error);
        }
        finally
        {
            _exportandoStock = false;
        }
    }

    private async Task<IEnumerable<ArticuloLookupDto>> BuscarArticulos(string texto, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(texto))
            return Enumerable.Empty<ArticuloLookupDto>();

        cancellationToken.ThrowIfCancellationRequested();

        var articulos = await ArticuloService.SearchLookupAsync(texto.Trim());

        cancellationToken.ThrowIfCancellationRequested();

        return articulos.Take(20).ToList();
    }

    private bool? ObtenerEstadoGarantia()
    {
        return _tipoEstado switch
        {
            TipoEstadoGarantia.Todos => null,
            TipoEstadoGarantia.Pendientes => false,
            TipoEstadoGarantia.Cerrados => true,
            _ => null
        };
    }

    private async Task ExportarGarantiaExcel()
    {
        // Evitar múltiples ejecuciones
        if (_exportandoGarantia)
            return;

        _exportandoGarantia = true;

        try
        {
            // Validar fechas
            if (!_fechaDesdeGarantia.HasValue ||
                !_fechaHastaGarantia.HasValue)
            {
                Snackbar.Add(
                    "Debe seleccionar las fechas del reporte.",
                    Severity.Warning);
                return;
            }

            if (_fechaDesdeGarantia.Value > _fechaHastaGarantia.Value)
            {
                Snackbar.Add(
                    "La fecha inicial no puede ser mayor que la fecha final.",
                    Severity.Warning);
                return;
            }

            var filtro = new ReporteGarantiaFilterDto
            {
                FechaDesde = _fechaDesdeGarantia.Value,
                FechaHasta = _fechaHastaGarantia.Value,
                Estado = ObtenerEstadoGarantia()
            };

            // Generar Excel
            var archivo = await ReporteService.ExportarGarantiasExcelAsync(filtro);

            // Verificar si existen datos para exportar
            if (archivo == null || archivo.Length == 0)
            {
                Snackbar.Add(
                    "No existen registros para exportar.",
                    Severity.Info);
                return;
            }

            // Descargar archivo
            await JSRuntime.InvokeVoidAsync(
                "downloadFile",
                "ReporteGarantia.xlsx",
                Convert.ToBase64String(archivo));

            Snackbar.Add(
                "Reporte de Garantías exportado correctamente.",
                Severity.Success);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ERROR EXPORTANDO GARANTÍAS: {ex}");

            Snackbar.Add(
                "Ocurrió un error al exportar el reporte de Garantías.",
                Severity.Error);
        }
        finally
        {
            // Habilitar nuevamente el botón
            _exportandoGarantia = false;
        }
    }

    public enum TipoMovimiento
    {
        Todos,
        Ingreso,
        Salida
    }

    public enum TipoEstadoGarantia
    {
        Todos,
        Pendientes,
        Cerrados
    }

    private async Task ExportarKardexExcel()
    {
        // Evitar múltiples ejecuciones
        if (_exportandoKardex)
            return;

        try
        {
            _exportandoKardex = true;

            // Validar fechas
            if (!_fechaDesdeKardex.HasValue ||
                !_fechaHastaKardex.HasValue)
            {
                Snackbar.Add(
                    "Debe seleccionar las fechas del reporte.",
                    Severity.Warning);
                return;
            }

            if (_fechaDesdeKardex.Value > _fechaHastaKardex.Value)
            {
                Snackbar.Add(
                    "La fecha inicial no puede ser mayor que la fecha final.",
                    Severity.Warning);
                return;
            }

            var filtro = new ReporteKardexFilterDto
            {
                FechaDesde = _fechaDesdeKardex.Value,
                FechaHasta = _fechaHastaKardex.Value,
                IdAlmacen = _idAlmacen ?? 1,
                IdLinea = null,
                IdArticulo = _articuloSeleccionado?.Id
            };

            byte[] archivo;

            switch (_tipo)
            {
                case TipoMovimiento.Ingreso:

                    archivo = await ReporteService
                        .ExportarIngresosExcelAsync(filtro);
                    break;

                case TipoMovimiento.Salida:

                    archivo = await ReporteService
                        .ExportarSalidasExcelAsync(filtro);
                    break;

                default:

                    archivo = await ReporteService
                        .ExportarKardexExcelAsync(filtro);
                    break;
            }

            // Validar si se generó un archivo
            if (archivo == null || archivo.Length == 0)
            {
                Snackbar.Add(
                    "No existen registros para exportar.",
                    Severity.Info);
                return;
            }

            await JSRuntime.InvokeVoidAsync(
                "downloadFile",
                "ReporteKardex.xlsx",
                Convert.ToBase64String(archivo));

            Snackbar.Add(
                "Reporte exportado correctamente.",
                Severity.Success);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ERROR EXPORTANDO KARDEX: {ex}");

            Snackbar.Add(
                "Ocurrió un error al exportar el reporte de Kardex.",
                Severity.Error);
        }
        finally
        {
            // Siempre habilitar nuevamente el botón
            _exportandoKardex = false;
        }
    }


    private async Task ExportarPedidoExcel()
    {
        // Evitar múltiples ejecuciones
        if (_exportandoPedido)
            return;

        _exportandoPedido = true;

        try
        {
            // Validar fechas obligatorias
            if (!_fechaDesdePedido.HasValue ||
                !_fechaHastaPedido.HasValue)
            {
                Snackbar.Add(
                    "Debe seleccionar las fechas del reporte.",
                    Severity.Warning);
                return;
            }

            // Validar rango de fechas
            if (_fechaDesdePedido.Value.Date >
                _fechaHastaPedido.Value.Date)
            {
                Snackbar.Add(
                    "La fecha inicial no puede ser mayor que la fecha final.",
                    Severity.Warning);
                return;
            }

            // Preparar filtros
            var filtro = new ReportePedidoFilterDto
            {
                FechaDesde = DateOnly.FromDateTime(
                    _fechaDesdePedido.Value),

                FechaHasta = DateOnly.FromDateTime(
                    _fechaHastaPedido.Value),

                Estado = _estadoPedido,

                Cliente = string.IsNullOrWhiteSpace(_clientePedido)
                    ? null
                    : _clientePedido.Trim()
            };

            // Generar Excel mediante el servicio
            var archivo = await ReporteService
                .ExportarPedidosExcelAsync(filtro);

            // Validar si existen registros
            if (archivo == null || archivo.Length == 0)
            {
                Snackbar.Add(
                    "No existen pedidos para exportar con los filtros seleccionados.",
                    Severity.Info);
                return;
            }

            // Nombre del archivo
            string nombreArchivo =
                $"ReportePedidos_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";

            // Descargar Excel
            await JSRuntime.InvokeVoidAsync(
                "downloadFile",
                nombreArchivo,
                Convert.ToBase64String(archivo));

            Snackbar.Add(
                "Reporte de Pedidos exportado correctamente.",
                Severity.Success);
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"ERROR EXPORTANDO PEDIDOS: {ex}");

            Snackbar.Add(
                "Ocurrió un error al exportar el reporte de Pedidos.",
                Severity.Error);
        }
        finally
        {
            // Habilitar nuevamente el botón
            _exportandoPedido = false;
        }
    }

}
